# Copy to .streamlit/secrets.toml for local runs (gitignored), or paste into
# "Settings -> Secrets" on Streamlit Community Cloud. Only set the block for the
# provider(s) you want available in the sidebar's "AI model" picker — the app
# runs fine with none set (deterministic analysis still works; nudges/chat are
# disabled until a key is present).

# Anthropic Claude models (claude-sonnet-4-6, claude-haiku-4-5-20251001)
ANTHROPIC_API_KEY = "sk-ant-..."

# Gemini Developer API key (AI Studio) — simplest path for hosted demos.
GEMINI_API_KEY = "..."

# Alternative to GEMINI_API_KEY: Vertex AI (requires GCP auth, not just a key;
# not usable on Streamlit Community Cloud without a service-account setup).
# GCP_PROJECT = "my-gcp-project"
# GCP_LOCATION = "us-central1"
