{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wearable-insights/contracts/comparison_object.schema.json",
  "title": "ComparisonObject",
  "description": "Compact, LLM-facing summary that is the contract between the deterministic analysis layers and the inference layer (FR-009). The LLM receives only this object, never raw daily tables.",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "analysis_date", "sleep", "heart_health", "activity", "candidate_associations", "data_quality", "schema_version"],
  "properties": {
    "user_id": { "type": "string", "minLength": 1 },
    "analysis_date": { "type": "string", "format": "date" },
    "schema_version": { "type": "string" },
    "sleep": { "$ref": "#/$defs/comparisonSection" },
    "heart_health": { "$ref": "#/$defs/comparisonSection" },
    "activity": { "$ref": "#/$defs/comparisonSection" },
    "candidate_associations": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateAssociation" }
    },
    "data_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing_fields", "invalid_fields", "low_confidence"],
      "properties": {
        "missing_fields": { "type": "array", "items": { "type": "string" } },
        "invalid_fields": { "type": "array", "items": { "type": "string" } },
        "low_confidence": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "comparisonSection": {
      "type": "object",
      "description": "Map of metric name to its comparison.",
      "additionalProperties": { "$ref": "#/$defs/metricComparison" }
    },
    "metricComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_value", "baseline_value", "percentage_change", "trend", "evaluation_tag", "flags"],
      "properties": {
        "current_value": { "type": ["number", "null"] },
        "baseline_value": { "type": ["number", "null"] },
        "percentage_change": { "type": ["number", "null"] },
        "trend": { "type": "string", "enum": ["up", "down", "stable"] },
        "evaluation_tag": {
          "type": "string",
          "enum": [
            "Significantly Elevated",
            "Significantly Depressed",
            "Critically Elevated",
            "Critically Depressed",
            "Stable / Within Normal Baseline"
          ]
        },
        "flags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "candidateAssociation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "signals", "description", "kind"],
      "properties": {
        "relation": { "type": "string", "minLength": 1 },
        "signals": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "description": { "type": "string", "minLength": 1 },
        "kind": { "const": "association" }
      }
    }
  }
}
