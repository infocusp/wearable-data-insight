{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wearable-insights/contracts/canonical_record.schema.json",
  "title": "CanonicalDailyRecord",
  "description": "One normalized day of wearable summary data for one user (FR-003, FR-004).",
  "type": "object",
  "additionalProperties": false,
  "required": ["user_id", "date", "missing_fields", "invalid_fields"],
  "properties": {
    "user_id": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "sleep_duration_minutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 1440 },
    "sleep_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "deep_sleep_minutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 600 },
    "rem_sleep_minutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 600 },
    "bedtime": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "resting_hr": { "type": ["integer", "null"], "minimum": 25, "maximum": 120 },
    "hrv_rmssd_ms": { "type": ["number", "null"], "minimum": 1, "maximum": 250 },
    "stress_score": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
    "steps": { "type": ["integer", "null"], "minimum": 0, "maximum": 100000 },
    "active_minutes": { "type": ["integer", "null"], "minimum": 0, "maximum": 1440 },
    "missing_fields": { "type": "array", "items": { "type": "string" } },
    "invalid_fields": { "type": "array", "items": { "type": "string" } }
  }
}
