# ── Wearable Insights FastAPI sidecar ────────────────────────────────────────
# Shared secret ClaimGuard sends as X-Wearable-Token. Generate with:
#   openssl rand -base64 32
WEARABLE_API_TOKEN=

# Fallback LLM credential, used when the caller does not forward X-LLM-Api-Key
# (e.g. server-initiated or scheduled analyses).
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: pin the model the sidecar uses. Defaults to gemini-2.5-flash-lite.
# WEARABLE_MODEL=gemini-2.5-flash-lite

# Anchor date for the startup cache warm-up. Set this to the demo's analysis date so the
# first request is warm; defaults to the container's today.
# WEARABLE_WARM_DATE=2026-08-25

# Reported by /v1/health so callers can detect an engine/schema change.
# WEARABLE_ENGINE_VERSION=005-claimguard-integration

# Deterministic-layer knobs (defaults are fine for the demo).
# BASELINE_HISTORY_DAYS=60
# NUDGE_COOLDOWN_SECS=600
# MAX_NUDGES_PER_DAY=3
